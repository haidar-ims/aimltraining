   "source": [
    "from sklearn.preprocessing import LabelEncoder\n",
    "\n",
    "colors = ['Apple', 'Banana', 'Mango', 'Orange', 'Apple', 'Orange']\n",
    "\n",
    "# Initialize LabelEncoder\n",
    "le = LabelEncoder()\n",
    "\n",
    "# Fit and transform\n",
    "encoded = le.fit_transform(colors)\n",
    "\n",
    "print(encoded)\n"
   ]
